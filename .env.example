# Safe Route AI — Environment Configuration
# Copy this file to .env to configure live API providers.
# If keys are omitted or left blank, the application automatically runs in DEMO / ILLUSTRATIVE MODE.

# -----------------------------------------------------------------------------
# Supabase Configuration (Frontend Client)
# -----------------------------------------------------------------------------
# Note: Use your project URL and ANON (public) key.
# NEVER place SUPABASE_SERVICE_ROLE_KEY here as this file is bundled into the client!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Modular Routing Provider Configuration
# -----------------------------------------------------------------------------
# Options: 'demo' | 'openrouteservice' | 'osrm'
VITE_ROUTING_PROVIDER=demo

# OpenRouteService API Key (Sign up for free at https://openrouteservice.org/)
# Required if VITE_ROUTING_PROVIDER=openrouteservice
VITE_OPENROUTESERVICE_API_KEY=

# Optional custom OSRM server endpoint (e.g., https://router.project-osrm.org)
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# -----------------------------------------------------------------------------
# Map Tile Provider (OpenStreetMap Compatible)
# -----------------------------------------------------------------------------
# MapLibre style JSON URL. Defaults to Carto Positron / OSM tiles (free, OSM-compliant)
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
